{
  "scriptId": "surrender-001",
  "title": "Surrender Request",
  "description": "Call script for handling customer surrender requests",
  "category": "Surrenders",
  "lastUpdated": "2026-07-22",
  "isPrimaryScript": true,
  "steps": [
    {
      "id": "step-1",
      "order": 1,
      "content": [
        {
          "id": "c1",
          "order": 1,
          "type": "required-check",
          "content": "Auto-verified checks",
          "requiredChecks": [
            { "question": "Policy number", "answer": "80007", "auto": true },
            { "question": "Surrender value", "answer": "£71,000", "auto": true },
            { "question": "Telephone", "answer": "0745678999", "auto": true },
            { "question": "Email", "answer": "joe.b@lauramipsum.com", "auto": true },
            { "question": "Policy invested in suspended fund", "answer": "No", "auto": true }
          ]
        },
        {
          "id": "c2",
          "order": 2,
          "type": "prompt",
          "content": "Before we get started, I’d like to let you know, that the value of your policy today is £71,000. This amount changes daily and isn’t guaranteed. It’s important to remember that fully cashing in your policy may not be your only option. Many policies have the ability to cash in some of the value and leave the remainder in your policy. If you’re struggling to pay the premiums you may also have the ability to stop payments now and leave your money invested. Hello Jit",
          "condition": { 
            "dependsOn": "c1", 
            "checkQuestion": "Policy invested in suspended fund", 
            "answer": "No" 
          }
        },
        {
          "id": "c3",
          "order": 3,
          "type": "question",
          "content": "Are you interested in any of these options?",
          "selectionMode": "single",
          "options": [
            { 
              "text": "Yes, interested in part surrender / PUP / premium holiday"
            },
            { 
              "text": "No, continue full surrender process",
              "nextStep": "step-2" 
            }
          ]
        }
      ]
    },
    {
      "id": "step-2",
      "order": 2,
      "content": [
        {
          "id": "c4",
          "order": 1,
          "type": "prompt",
          "content": "There's a few different ways you can request this. Over the phone, on our website, or we can send you the forms to fill in."
        },
        {
          "id": "c5",
          "order": 2,
          "type": "question",
          "content": "Which would you prefer?",
          "selectionMode": "single",
          "options": [
            { "text": "Over the phone" },
            { "text": "On our website" },
            { "text": "Send forms to fill in" }
          ]
        },
        {
          "id": "c6",
          "order": 3,
          "type": "prompt",
          "content": "Great thanks for confirming, I’m just going to check some details on your policy. I’m going to pop you on hold for a minute or so while I do that.",
          "condition": { "dependsOn": "c5" }
        }
      ]
    },
    {
      "id": "step-3",
      "order": 3,
      "content": [
        {
          "id": "c7",
          "order": 1,
          "type": "required-check",
          "content": "Auto-verified checks",
          "requiredChecks": [
            { "question": "Policy changes within last 6 months?", "answer": "No", "auto": true },
            { "question": "In arrears?", "answer": "No", "auto": true },
            { "question": "Value under £100k", "answer": "Yes", "auto": true },
            { "question": "Joint or Single ownership?", "answer": "Single", "auto": true },
            { "question": "FMISA? (Flexible Mortgage Individual Savings Account)", "answer": "No", "auto": true },
            { "question": "OUK? (Outside of UK)", "answer": "No", "auto": true },
            { "question": "Manual calculation or policy in debt?", "answer": "No", "auto": true },
            { "question": "Policy on hold?", "answer": "No", "auto": true },
            { "question": "FA calling? (Financial Adviser)", "answer": "No", "auto": true },
            { "question": "POA calling? (Power of Attorney)", "answer": "No", "auto": true },
            { "question": "Open bill?", "answer": "No", "auto": true },
            { 
              "question": "Is this policy in trust or assigned?", 
              "manual": true,
              "selectionMode": "single",
              "options": [
                { "text": "Trust" },
                { "text": "Assigned" }
              ]
            }
          ]
        }
      ]
    }
  ]
}