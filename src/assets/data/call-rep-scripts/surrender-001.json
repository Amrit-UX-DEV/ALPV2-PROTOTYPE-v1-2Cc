{
  "scriptId": "surrender-001",
  "title": "Surrender Request",
  "description": "Call script for handling customer surrender requests",
  "category": "Surrenders",
  "lastUpdated": "2026-08-12",
  "isPrimaryScript": true,
  "steps": [
    {
      "id": "step-1",
      "order": 1,
      "content": [
        {
          "id": "c1",
          "order": 1,
          "type": "required-check",
          "content": "Initial checks",
          "requiredChecks": [
            {
              "question": "Is the policy invested in a suspended fund?",
              "manual": true,
              "selectionMode": "single",
              "options": [
                { "text": "Yes", "nextStep": "step-suspended-fund" },
                { "text": "No", "nextStep": "step-2" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "step-2",
      "order": 2,
      "content": [
        {
          "id": "c2",
          "order": 1,
          "type": "required-check",
          "content": "Surrender options checks",
          "requiredChecks": [
            {
              "question": "Does the policy allow partial surrender, PUP, premium holiday?",
              "manual": true,
              "selectionMode": "single",
              "options": [
                { "text": "Yes", "nextStep": "step-3" },
                { "text": "No", "nextStep": "step-4" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "step-3",
      "order": 3,
      "content": [
        {
          "id": "c3",
          "order": 1,
          "type": "prompt",
          "content": "It's important to remember that fully cashing in your policy may not be your only option. You also have the option to part surrender, paid-up, premium holiday."
        },
        {
          "id": "c4",
          "order": 2,
          "type": "question",
          "content": "Are you interested in these options?",
          "selectionMode": "single",
          "options": [
            { "text": "Interested in part surrender", "nextStep": "step-part-surrender" },
            { "text": "Interested in paid up / premium holiday", "nextStep": "step-paid-up-premium-holiday" },
            { "text": "No, continue full surrender process", "nextStep": "step-4" }
          ]
        }
      ]
    },
    {
      "id": "step-4",
      "order": 4,
      "content": [
        {
          "id": "c5",
          "order": 1,
          "type": "prompt",
          "content": "Before we get started, I'd like to let you know that the value of your policy today is {{policyValue}}. This amount changes daily and isn't guaranteed."
        }
      ]
    },
    {
      "id": "step-suspended-fund",
      "order": 5,
      "content": [
        {
          "id": "c6",
          "order": 1,
          "type": "prompt",
          "content": "[Daisy chain] Policy is invested in a suspended fund. Handle via suspended-fund process."
        }
      ]
    },
    {
      "id": "step-part-surrender",
      "order": 6,
      "content": [
        {
          "id": "c7",
          "order": 1,
          "type": "prompt",
          "content": "[Daisy chain] Interested in part surrender. Handle via part-surrender process."
        }
      ]
    },
    {
      "id": "step-paid-up-premium-holiday",
      "order": 7,
      "content": [
        {
          "id": "c8",
          "order": 1,
          "type": "prompt",
          "content": "[Daisy chain] Interested in paid-up / premium holiday. Handle via paid-up or premium-holiday process."
        }
      ]
    }
  ]
}
