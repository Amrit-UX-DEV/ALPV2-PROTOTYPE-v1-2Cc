    "prm.alternatives-intro": {
      "unitId": "prm.alternatives-intro",
      "version": 1,
      "kind": "prompt",
      "body": "It's important to remember that fully cashing in your policy may not be your only option."
    },
    "prm.both-ph-needed": {
      "unitId": "prm.both-ph-needed",
      "version": 1,
      "kind": "prompt",
      "body": "We won't be able to do this over the phone today without speaking to both policyholders. You can either call us back when you're both available, complete this on our website, or I can send you the forms to complete via email or post."
    },
    "prm.can-complete-phone": {
      "unitId": "prm.can-complete-phone",
      "version": 1,
      "kind": "prompt",
      "body": "Thanks for confirming, we should be able to complete this over the phone for you today."
    },
    "prm.can-process-request": {
      "unitId": "prm.can-process-request",
      "version": 1,
      "kind": "prompt",
      "body": "Based on your policy and the information you've given me, we can process your request."
    },
    "prm.fastest-over-phone": {
      "unitId": "prm.fastest-over-phone",
      "version": 1,
      "kind": "prompt",
      "body": "The fastest way to do this is over the phone and we should be able to help you with this today. Otherwise you can request this on our website or we can send you the forms to fill in."
    },
    "prm.form-and-id": {
      "unitId": "prm.form-and-id",
      "version": 1,
      "kind": "prompt",
      "body": "To cash in your policy there's a form you need to fill in and you might also need to send us some ID."
    },
    "prm.moneyhelper-signpost": {
      "unitId": "prm.moneyhelper-signpost",
      "version": 1,
      "kind": "prompt",
      "body": "Ok, that's understandable. You can find lots of helpful information at moneyhelper.org.uk, including help finding a financial adviser if you need one. To cash in your policy there's just a simple form you need to complete if you decide to go ahead. You might be able to request this on our website. I can also get this sent through the post or by email if you prefer."
    },
    "prm.pop-on-hold": {
      "unitId": "prm.pop-on-hold",
      "version": 1,
      "kind": "prompt",
      "body": "Great, thanks for confirming. I'm just going to check some details on your policy. I'm going to pop you on hold for a minute or so while I do that."
    },
    "prm.suspended-fund": {
      "unitId": "prm.suspended-fund",
      "version": 1,
      "kind": "prompt",
      "body": "You are currently invested in suspended funds, we've written to you to explain what this means. <Refer to mailing if needed>. We will need to check whether payment can be made from this/these suspended funds and let you know. We'll write to you and if you do have any options we'll also send any forms you need to complete at the same time. This can take 10 working days."
    },
    "prm.things-to-know": {
      "unitId": "prm.things-to-know",
      "version": 1,
      "kind": "prompt",
      "body": "If you decide to go ahead and cash in your policy, there's some things we need to make you aware of."
    },
    "prm.third-party-claim": {
      "unitId": "prm.third-party-claim",
      "version": 1,
      "kind": "prompt",
      "body": "Just so you know, if it should come to light that a third party has a genuine claim on this policy, we may need to recover the payment."
    },
    "prm.value-today": {
      "unitId": "prm.value-today",
      "version": 1,
      "kind": "prompt",
      "body": "Before we get started, I'd like to let you know that the value of your policy today is {{policyValue}}. This amount changes daily and isn't guaranteed.",
      "placeholders": [
