    "chk.suspended-fund": {
      "unitId": "chk.suspended-fund",
      "version": 1,
      "kind": "automated",
      "label": "Is the policy invested in a suspended fund?",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/suspended_fund",
        "restData": [],
        "resultPath": "items[0].suspendedFund",
        "outcomeMap": {
          "Y": "Yes",
          "N": "No"
