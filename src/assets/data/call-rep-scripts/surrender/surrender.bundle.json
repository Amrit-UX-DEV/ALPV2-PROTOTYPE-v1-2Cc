    {
      "stepId": "st-can-phone",
      "version": 1,
      "title": "Complete over the phone",
      "content": [
        {
          "id": "c-can-phone",
          "ref": "prm.can-complete-phone"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "routes": [
            {
              "to": "st-scam"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-other-ph",
      "version": 1,
      "title": "Other policyholder present?",
      "content": [
        {
          "id": "c-other-ph",
          "ref": "qst.other-ph-with-you"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-other-ph.answered",
          "routes": [
            {
              "when": "c-other-ph.value == 'yes'",
              "to": "st-speak-ph"
            },
            {
              "to": "st-both-needed"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-speak-ph",
      "version": 1,
      "title": "Speak to other policyholder now?",
      "content": [
        {
          "id": "c-speak-ph",
          "ref": "qst.speak-other-ph-now"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-speak-ph.answered",
          "routes": [
            {
              "when": "c-speak-ph.value == 'yes'",
              "to": "st-capture-ph"
            },
            {
              "to": "st-both-needed"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-capture-ph",
      "version": 1,
      "title": "Capture policyholder names",
      "content": [
        {
          "id": "c-capture-ph",
          "ref": "act.capture-ph-names"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "routes": [
            {
              "to": "st-happy-joint"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-happy-joint",
      "version": 1,
      "title": "Happy to continue jointly?",
      "content": [
        {
          "id": "c-happy-joint",
          "ref": "qst.happy-continue-joint"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-happy-joint.answered",
          "routes": [
            {
              "when": "c-happy-joint.value == 'yes'",
              "to": "st-can-process"
            },
            {
              "to": "st-signpost-moneyhelper"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-can-process",
      "version": 1,
      "title": "Can process the request",
      "content": [
        {
          "id": "c-can-process",
          "ref": "prm.can-process-request"
        },
        {
          "id": "c-things",
          "ref": "prm.things-to-know"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "routes": [
            {
              "to": "st-scam"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-scam",
      "version": 1,
      "title": "Scam awareness & advice",
      "callFlow": {
        "ref": "scam-and-advice"
      },
      "onExit": {
        "proceed": "st-chargeable",
        "think-stop": "st-signpost-moneyhelper"
      }
    },
    {
      "stepId": "st-chargeable",
      "version": 1,
      "title": "Chargeable event",
      "callFlow": {
        "ref": "chargeable-event"
      },
      "onExit": {
        "proceed": "st-online-or-phone",
        "think-stop": "st-signpost-moneyhelper"
      }
    },
    {
      "stepId": "st-online-or-phone",
      "version": 1,
      "title": "Online or phone?",
      "content": [
        {
          "id": "c-online-or-phone",
          "ref": "qst.online-or-phone"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-online-or-phone.answered",
          "routes": [
            {
              "when": "c-online-or-phone.value == 'online'",
              "to": "st-online"
            },
            {
              "to": "st-payment"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-online",
      "version": 1,
      "title": "Direct to Help Centre",
      "content": [
        {
          "id": "c-online-act",
          "ref": "act.direct-help-centre"
        }
      ],
      "buttons": [
        {
          "key": "back",
          "kind": "back",
          "label": "Back"
        },
        {
          "key": "end",
          "kind": "end",
          "label": "End call"
        }
      ]
    },
    {
      "stepId": "st-payment",
      "version": 1,
      "title": "Payment collection & EID",
      "callFlow": {
        "ref": "payment-collection-and-eid"
      }
    },
    {
      "stepId": "st-signpost-moneyhelper",
      "version": 1,
      "title": "Signpost MoneyHelper",
      "callFlow": {
        "ref": "offer-all-channels",
        "args": {
          "leadPrompt": "prm.moneyhelper-signpost"
        }
      }
    },
    {
      "stepId": "st-both-needed",
      "version": 1,
      "title": "Both policyholders needed",
      "callFlow": {
        "ref": "offer-all-channels",
        "args": {
          "leadPrompt": "prm.both-ph-needed"
        }
      }
    },
    {
      "stepId": "st-fail-form",
      "version": 1,
      "title": "Not eligible - offer form",
      "callFlow": {
        "ref": "offer-form",
        "args": {
          "leadPrompt": "prm.form-and-id"
        }
      }
    },
    {
      "stepId": "st-paper-form",
      "version": 1,
      "title": "Paper form",
      "callFlow": {
        "ref": "offer-form"
      }
    }
  ],
  "flows": {
    "offer-all-channels": {
      "ref": "offer-all-channels",
      "version": 1
    },
    "offer-form": {
      "ref": "offer-form",
      "version": 1
    },
    "partial-surrender-form": {
      "ref": "partial-surrender-form",
      "version": 1
    },
    "pup-ph-info": {
      "ref": "pup-ph-info",
      "version": 1
    },
    "scam-and-advice": {
      "ref": "scam-and-advice",
      "version": 1
    },
    "chargeable-event": {
      "ref": "chargeable-event",
      "version": 1
    },
    "payment-collection-and-eid": {
      "ref": "payment-collection-and-eid",
      "version": 1
    }
  },
  "units": {
    "act.capture-ph-names": {
      "unitId": "act.capture-ph-names",
      "version": 1,
      "kind": "action",
      "actionType": "capture",
      "label": "Capture details - current policyholder's name, 2nd policyholder's name.",
      "captureFields": ["currentPolicyholderName", "secondPolicyholderName"]
    },
    "act.direct-help-centre": {
      "unitId": "act.direct-help-centre",
      "version": 1,
      "kind": "action",
      "actionType": "signpost",
      "label": "Direct to Help Centre help.reassure.co.uk",
      "binding": null
    },
    "act.log-task-suspended-reqs": {
      "unitId": "act.log-task-suspended-reqs",
      "version": 1,
      "kind": "action",
      "actionType": "log-task",
      "label": "Log a task for back office to send surrender requirements, noting this policy has suspended funds.",
      "binding": {
        "method": "POST",
        "url": "trans/surrender/log_task",
        "data": {
          "taskType": "SURRENDER_REQ_SUSPENDED"
        }
      }
    },
    "chk.allow-alternatives": {
      "unitId": "chk.allow-alternatives",
      "version": 1,
      "kind": "automated",
      "label": "Does the policy allow partial surrender / PUP / premium holiday?",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/alternatives_allowed",
        "restData": [],
        "resultPath": "items[0].allowed",
        "outcomeMap": {
          "Y": "Yes",
          "N": "No"
        }
      },
      "outcomes": ["Yes", "No"],
      "styling": {
        "Yes": "pass",
        "No": "fail"
      }
    },
    "chk.policy-features": {
      "unitId": "chk.policy-features",
      "version": 1,
      "kind": "automated",
      "label": "Does policy have cover/benefits/guarantees, surrender penalty (excl MVR), MVR, or bonuses that reduce on surrender?",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/features",
        "restData": [],
        "resultPath": "items[0]",
        "aggregateFlag": {
          "outputKey": "anyWarning",
          "trueWhenAny": ["hasBenefits", "hasPenalty", "hasMvr", "hasBonuses"]
        }
      },
      "outcomes": []
    },
    "chk.policy-value": {
      "unitId": "chk.policy-value",
      "version": 1,
      "kind": "automated",
      "label": "Current surrender value",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/value",
        "restData": [],
        "resultPath": "items[0].policyValue"
      },
      "outcomes": []
    },
    "chk.pre-surrender-flags": {
      "unitId": "chk.pre-surrender-flags",
      "version": 1,
      "kind": "automated",
      "label": "Pre-surrender eligibility flags (bulk)",
      "comment": "Single ORDS call returning every sub-flag; the waypoint aggregates Green/Red.",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/pre_checks",
        "restData": [],
        "resultPath": "items[0]",
        "subChecks": [
          {
            "key": "nameAddrBankChanged6m",
            "label": "PH Name, Address or Bank Details changed within last 6 months"
          },
          {
            "key": "fctWarningFlag",
            "label": "FCT warning flag present"
          },
          {
            "key": "policyInArrears",
            "label": "Policy in arrears"
          },
          {
            "key": "valueOver100k",
            "label": "Value over £100k"
          },
          {
            "key": "addressOuk",
            "label": "PH address OUK"
          },
