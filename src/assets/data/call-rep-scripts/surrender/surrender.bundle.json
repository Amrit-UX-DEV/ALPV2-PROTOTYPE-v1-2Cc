    "prm.warnings-conditional": {
      "unitId": "prm.warnings-conditional",
      "version": 1,
      "kind": "prompt",
      "conditionalSegments": true,
      "body": "{{#hasBenefits}}Your policy provides {{benefits}} which will be lost if you cash in your policy. {{/hasBenefits}}{{#hasPenalty}}There is an exit fee or penalty for cashing in your policy early {{penaltyDetail}}. {{/hasPenalty}}{{#hasMVR}}A Market Value Reduction may apply. {{/hasMVR}}{{#hasBonuses}}Bonuses may reduce on surrender. Guaranteed amounts only apply if premiums are paid when due; if you end your policy early these guaranteed amounts will not apply and we'll work out new values. Final bonuses are not guaranteed and will be reduced if you cancel your policy early. {{/hasBonuses}}",
      "placeholders": [
        {
          "key": "hasBenefits",
          "source": "chk.policy-features",
          "path": "items[0].hasBenefits"
        },
        {
          "key": "benefits",
          "source": "chk.policy-features",
          "path": "items[0].benefits"
        },
        {
          "key": "hasPenalty",
          "source": "chk.policy-features",
          "path": "items[0].hasPenalty"
        },
        {
          "key": "penaltyDetail",
          "source": "chk.policy-features",
          "path": "items[0].penaltyDetail"
        },
        {
          "key": "hasMVR",
          "source": "chk.policy-features",
          "path": "items[0].hasMvr"
        },
        {
          "key": "hasBonuses",
          "source": "chk.policy-features",
          "path": "items[0].hasBonuses"
        }
      ]
    },
    "prm.website-link-warnings": {
