{
  "_comment": "EXAMPLE - the response body ORDS returns for GET /scripts/flow/chargeable-event?version=1. Each callable flow is fetched by its own REST call (the path segment is the flow id, the version query pins the frozen version). At session start the engine fires all of these flow calls in parallel, alongside the bundle (/lookup) and the checks prefetch (/prefetch), then caches each for the session - so entering a callFlow step into chargeable-event never blocks. The payload is a self-contained CallableFlow: startStepId/terminal/params/exits/steps PLUS its own 'units' (every library unit its steps reference), so it renders without the main bundle. Nested flows it calls are fetched by their own parallel GET /scripts/flow/... calls the same way.",
  "version": 1,
  "scriptId": "chargeable-event",
  "title": "Chargeable event / non-qualifying policy warning",
  "terminal": false,
  "params": [],
  "exits": ["proceed", "think-stop"],
  "startStepId": "st-ce-check",
  "steps": [
    {
      "stepId": "st-ce-check",
      "version": 1,
      "title": "Non-qualifying check",
      "onEnter": [
        {
          "kind": "check",
          "ref": "chk.non-qualifying"
        }
      ],
      "content": [],
      "buttons": [
        {
          "key": "auto",
          "kind": "auto",
          "routes": [
            {
              "when": "chk.non-qualifying == 'Yes'",
              "to": "st-ce-cgt"
            },
            {
              "to": "@exit:proceed"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-ce-cgt",
      "version": 1,
      "title": "Chargeable event",
      "content": [
        {
          "id": "c-cgt",
          "ref": "prm.chargeable-event"
        },
        {
          "id": "c-more-info",
          "ref": "qst.more-info-cgt"
        }
      ],
      "buttons": [
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-more-info.answered",
          "routes": [
            {
              "when": "c-more-info.value == 'yes'",
              "to": "st-ce-hmrc"
            },
            {
              "to": "@exit:proceed"
            }
          ]
        }
      ]
    },
    {
      "stepId": "st-ce-hmrc",
      "version": 1,
      "title": "HMRC helpsheet",
      "content": [
        {
          "id": "c-hmrc",
          "ref": "prm.hmrc-helpsheet"
        },
        {
          "id": "c-continue",
          "ref": "qst.continue"
        }
      ],
      "buttons": [
        {
          "key": "next",
          "kind": "next",
          "label": "Next",
          "enabledWhen": "c-continue.answered",
          "routes": [
            {
              "when": "c-continue.value == 'think'",
              "to": "@exit:think-stop"
            },
            {
              "to": "@exit:proceed"
            }
          ]
        }
      ]
    }
  ],
  "units": {
    "chk.non-qualifying": {
      "unitId": "chk.non-qualifying",
      "version": 1,
      "kind": "automated",
      "label": "Is policy non-qualifying?",
      "binding": {
        "method": "GET",
        "url": "policy/surrender/non_qualifying",
        "restData": [],
        "resultPath": "items[0].nonQualifying",
        "outcomeMap": {
          "Y": "Yes",
          "N": "No"
        }
      },
      "outcomes": ["Yes", "No"]
    },
    "prm.chargeable-event": {
      "unitId": "prm.chargeable-event",
      "version": 1,
      "kind": "prompt",
      "body": "Cashing in your policy early could cause a chargeable event gain. If this occurs, there may be tax to pay."
    },
    "prm.hmrc-helpsheet": {
      "unitId": "prm.hmrc-helpsheet",
      "version": 1,
      "kind": "prompt",
      "body": "HMRC have a help sheet on their website called 'Gains on UK life insurance policies' which explains this in more detail."
    },
    "qst.continue": {
      "unitId": "qst.continue",
      "version": 1,
      "kind": "question",
      "prompt": "Would you like to continue?",
      "selectionMode": "single",
      "options": [
        {
          "key": "continue",
          "text": "Continue"
        },
        {
          "key": "think",
          "text": "Think"
        }
      ]
    },
    "qst.more-info-cgt": {
      "unitId": "qst.more-info-cgt",
      "version": 1,
      "kind": "question",
      "prompt": "Would you like more information on this?",
      "selectionMode": "single",
      "options": [
        {
          "key": "yes",
          "text": "Yes"
        },
        {
          "key": "no",
          "text": "No"
        }
      ]
    }
  }
}
